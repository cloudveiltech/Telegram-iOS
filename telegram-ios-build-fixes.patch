+    export HOME=/tmp && "$$CMAKE_BIN_PATH" -DCMAKE_POLICY_VERSION_MINIMUM=3.5 .. -DYASM_BUILD_TESTS=OFF -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF -DPYTHON_EXECUTABLE="$$(which python3)"
     make -j $$core_count
     popd
 
