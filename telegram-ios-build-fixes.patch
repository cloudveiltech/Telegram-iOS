+    sed -i.bak 's|$${_tmp_GENVERSION_EXE}|$$<TARGET_FILE:genversion>|g' modules/preprocs/nasm/CMakeLists.txt
+    sed -i.bak 's|DEPENDS $${_tmp_GENVERSION_EXE}|DEPENDS genversion|g' modules/preprocs/nasm/CMakeLists.txt
+
