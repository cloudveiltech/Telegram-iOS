
load(
  "@rules_pods//BazelExtensions:extensions.bzl",
  "acknowledged_target",
  "gen_module_map",
  "gen_includes",
  "headermap",
  "umbrella_header"
)
# Add a config setting release for compilation mode
# Assume that people are using `opt` for release mode
# see the bazel user manual for more information
# https://docs.bazel.build/versions/master/be/general.html#config_setting
config_setting(
  name = "release",
  values = {
    "compilation_mode": "opt"
  }
)
config_setting(
  name = "osxCase",
  values = {
    "apple_platform_type": "macos"
  }
)
config_setting(
  name = "tvosCase",
  values = {
    "apple_platform_type": "tvos"
  }
)
config_setting(
  name = "watchosCase",
  values = {
    "apple_platform_type": "watchos"
  }
)
filegroup(
  name = "ObjectMapper_package_hdrs",
  srcs = [
    "ObjectMapper_direct_hdrs"
  ],
  visibility = [
    "//visibility:public"
  ]
)
filegroup(
  name = "ObjectMapper_direct_hdrs",
  srcs = glob(
    [
      "pod_support/Headers/Public/**/*"
    ]
  ),
  visibility = [
    "//visibility:public"
  ]
)
filegroup(
  name = "ObjectMapper_public_hdrs",
  srcs = [],
  visibility = [
    "//visibility:public"
  ]
)
filegroup(
  name = "ObjectMapper_hdrs",
  srcs = glob(
    [
      "pod_support/Headers/Public/**/*"
    ]
  ),
  visibility = [
    "//visibility:public"
  ]
)
headermap(
  name = "ObjectMapper_hmap",
  namespace = "ObjectMapper",
  hdrs = [
    "ObjectMapper_package_hdrs",
    ":ObjectMapper_hdrs"
  ],
  deps = [],
  visibility = [
    "//visibility:public"
  ]
)
gen_includes(
  name = "ObjectMapper_includes",
  include = [
    "external/ObjectMapper/pod_support/Headers/Public/"
  ]
)
objc_library(
  name = "ObjectMapper",
  enable_modules = 1,
  module_map = ":ObjectMapper_module_map",
  hdrs = [
    ":ObjectMapper_hdrs"
  ],
  pch = "pod_support/Headers/Private/ObjectMapper-prefix.pch",
  deps = [
    ":ObjectMapper_includes",
    ":ObjectMapper_module_map"
  ],
  copts = [
    "-I$(GENDIR)/external/ObjectMapper/",
    "-fobjc-weak",
    "-Wnon-modular-include-in-framework-module",
    "-g",
    "-stdlib=libc++",
    "-DCOCOAPODS=1",
    "-DOBJC_OLD_DISPATCH_PROTOTYPES=0",
    "-fdiagnostics-show-note-include-stack",
    "-fno-common",
    "-fembed-bitcode-marker",
    "-fmessage-length=0",
    "-fpascal-strings",
    "-fstrict-aliasing",
    "-Wno-error=nonportable-include-path"
  ] + select(
    {
      "//conditions:default": [
        "-DDEBUG=1",
        "-DPOD_CONFIGURATION_DEBUG=1"
      ],
      ":release": [
        "-DPOD_CONFIGURATION_RELEASE=1",
        "-DNS_BLOCK_ASSERTIONS=1"
      ]
    }
  ) + [
    "-Iexternal/ObjectMapper/pod_support/Headers/Public/ObjectMapper/"
  ] + [
    "-fmodule-name=ObjectMapper",
    "-fmodules"
  ],
  visibility = [
    "//visibility:public"
  ]
)
acknowledged_target(
  name = "ObjectMapper_acknowledgement",
  deps = [],
  value = "@ObjectMapper//pod_support_buildable:acknowledgement_fragment"
)
gen_module_map(
  name = "ObjectMapper_module_map",
  module_name = "ObjectMapper",
  hdrs = [
    "ObjectMapper_public_hdrs"
  ],
  visibility = [
    "//visibility:public"
  ]
)